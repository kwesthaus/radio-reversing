flowchart TD
    A[".lmx file"] --"AES CBC"--> B[".xml with top-level FLASH_PACK node"]
    B --> C1["FIRMWARE node"]
    B --> C2["APP_UTILITIES node"]
    B --> C3["CONTROL_HEAD node"]
    B --> C4["FILE_CHANGE_LIST node"]
    B --> C5["GLOBAL_MARKER node"]
    B --> C6["DATA_IMAGE node"]
    B --> C7["L2_BOOTLOADER node"]
    B --> C8["L3_BOOTLOADER node"]
    B --> C9["CONFIGURATION node"]
    B --> C10["KERNEL node"]
    B --> C11["ROOT_FILE_SYSTEM node"]
    B --> C12["PSDT node"]
    B --> C13["PARTITION_TABLE node"]
    B --> C14["RAMDLOADER node"]
    B --> C15["..."]

    C1 --"base64 decode"--> D1["encrypted blob"]
    D1 --"AES CBC"--> E1["compressed blob"]
    E1 --"remove BOM and zcat"--> F1["xml"]
    F1 --"root-&gt;Partition-&gt;Payload node, Type=FTL"--> G1["hex"]
    G1 --"hex to binary"--> H1["cpio?"]

    C2 --"base64 decode"--> D2["encrypted blob"]
    D2 --"AES CBC"--> E2["compressed blob"]
    E2 --"remove BOM and zcat"--> F2["xml"]
    F2 --"root-&gt;Partition-&gt;Payload node, TYPE=FTL"--> G2["hex"]
    G2 --"hex to binary"--> H2["Tuxera Reliance filesystem"]
    H2 --"?"--> I2["shell scripts and ELF binaries"]

    C3 --"base64 decode"--> D3["encrypted blob"]
    D3 --"AES CBC"--> E3["compressed blob"]
    E3 --"remove BOM and zcat"--> F3["xml"]
    F3 --"root-&gt;Partition-&gt;Payload node, TYPE=FileSystem"--> G3["hex"]
    G3 --"hex to binary"--> H3["Paradise_CH_Non_Color_Display.hex, intel hex object"]
    H3 --"?"--> I3["baremetal binary?"]

    C6 --"base64 decode FTL Color"--> D6A["encrypted blob"]
    C6 --"base64 decode Filesystem Color"--> D6B["encrypted blob"]
    C6 --"base64 decode FTL Numeric"--> D6C["encrypted blob"]
    C6 --"base64 decode Filesystem Numeric"--> D6D["encrypted blob"]
    D6D --"AES CBC"--> E6D["compressed blob"]
    E6D --"remove BOM and zcat"--> F6D["xml"]
    F6D --"root-&gt;Partition-&gt;Payload node, TYPE=FileSystem"--> G6D["hex"]
    G6D --"hex to binary"--> H6D["NL5500_BIST_ai2_patch128.ce, baremetal binary?"]

    C7 --"base64 decode"--> D7["encrypted blob"]
    D7 --"AES CBC"--> E7["compressed blob"]
    E7 --"remove BOM and zcat"--> F7["xml"]
    F7 --"root-&gt;Partition-&gt;Payload node, TYPE=RawNAND"--> G7["hex"]
    G7 --"hex to binary"--> H7["TI AIS boot binary"]

    C11 --"base64 decode"--> D11["encrypted blob"]
    D11 --"AES CBC"--> E11["compressed blob"]
    E11 --"remove BOM and zcat"--> F11["xml"]
    F11 --"root-&gt;Partition-&gt;Payload node, Type=FTL"--> G11["hex"]
    G11 --"hex to binary"--> H11["cpio?"]

    C13 --"base64 decode"--> D13["encrypted blob"]
    D13 --"AES CBC"--> E13["compressed blob"]
    E13 --"remove BOM and zcat"--> F13["xml"]
    F13 --"root-&gt;Partition-&gt;Payload node, TYPE=FTL"--> G13["hex"]
    G13 --"hex to binary"--> H13["DOS/MBR boot sector"]

    C14 --"base64 decode"--> D14["encrypted blob"]
    D14 --"AES CBC"--> E14["compressed blob"]
    E14 --"remove BOM and zcat"--> F14["srec &quot;SWINFOFFRDR&quot;, continuous 0xc0400000 through 0xc044a28c, final byte at 0xc044b0fa"]

